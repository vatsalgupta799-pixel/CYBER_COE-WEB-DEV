# -------------------------------------------------------------
# CYBER COE — Environment Configuration Template
# Copy this file to .env.local and populate with your own values.
# NEVER commit .env or .env.local to version control!
# -------------------------------------------------------------

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/cyber_coe

# Authentication Secrets (Generate secure random 256-bit strings for production)
JWT_SECRET=your_jwt_secret_min_32_characters_here
CSRF_SECRET=your_csrf_secret_min_32_characters_here

# Trusted CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000,https://127.0.0.1:3000,http://127.0.0.1:3000

# Rate Limiting Configuration
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
