    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
